CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# -O2: the LVGL/emote/TFLM hot paths are compiled code, and the app slot
# has more than a megabyte of slack to trade for speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_USE_MICRO_WAKE_WORD=y
# The current "Hey, Apólo" model evaluates at ~68% recall; 50 is its usable
# operating point. Raise toward 90 when a stronger model lands.
CONFIG_MICRO_WAKE_WORD_PROBABILITY_CUTOFF=50

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

CONFIG_APOLLO_PROTOCOL=y

# --- Power management (battery life) ---
# Without PM_ENABLE the CPU is pinned at 240 MHz forever and esp_pm_configure()
# is a no-op, so the board's PowerSaveTimer could dim the panel but never idle
# the chip: an "idle" desk box drew nearly as much as a talking one and died in
# under two hours. With PM + tickless idle the scheduler drops to 40 MHz and
# light-sleeps between ticks whenever no task is runnable.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
# Keep the sleep/wake and Wi-Fi sleep paths in IRAM: without this every wake
# pays a flash-cache miss, which eats the savings on short idle windows.
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
# PSRAM is powered from an external regulator that leaks in light sleep unless
# the workaround holds it up; without it octal PSRAM can come back corrupted.
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y
CONFIG_ESP_SLEEP_FLASH_LEAKAGE_WORKAROUND=y

# The on-device Wi-Fi picker needs these LVGL widgets: a list of scanned
# networks and a keyboard for the password (menu_layer.cc).
CONFIG_LV_USE_LIST=y
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_TEXTAREA=y
CONFIG_LV_USE_BUTTONMATRIX=y
